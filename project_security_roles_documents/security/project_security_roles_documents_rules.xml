<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="rule_documents_project_user_scoped_read" model="ir.rule">
            <field name="name">Project Documents Scoped Read</field>
            <field name="model_id" ref="documents.model_documents_document"/>
            <field name="domain_force">['|', ('owner_id', '=', user.id), ('project_id', 'in', user.project_security_visible_project_ids.ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

        <record id="rule_documents_project_manager_full_read" model="ir.rule">
            <field name="name">Project Documents Manager Full Read</field>
            <field name="model_id" ref="documents.model_documents_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
        </record>
    </data>
</odoo>
