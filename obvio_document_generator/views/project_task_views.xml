<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_view_form_inherit_document_generator" model="ir.ui.view">
        <field name="name">project.task.view.form.inherit.document.generator</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Add Generate Document Button -->
            <xpath expr="//header" position="inside">
                <field name="is_document_generator_stage" invisible="1"/>
                <!-- Button is only visible if the task is in a stage that allows document generation -->
                <button name="action_generate_document" type="object" string="Generate Document"
                        class="oe_highlight" invisible="not is_document_generator_stage"/>
            </xpath>

            <!-- Add Document Comment Field -->
            <xpath expr="//page[@name='description_page']" position="after">
                <page name="document_generation_page" string="Document Generation" invisible="not is_document_generator_stage">
                    <group>
                        <field name="document_comment"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
