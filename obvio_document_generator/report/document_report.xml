<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper format for landscape presentations -->
    <record id="paperformat_task_document" model="report.paperformat">
        <field name="name">Task Document Presentation</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_task_document" model="ir.actions.report">
        <field name="name">Generate Document</field>
        <field name="model">project.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">obvio_document_generator.report_task_document</field>
        <field name="report_file">obvio_document_generator.report_task_document</field>
        <field name="print_report_name">'Document - %s' % (object.name)</field>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="obvio_document_generator.paperformat_task_document"/>
    </record>
</odoo>
